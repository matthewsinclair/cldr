#!/bin/sh
# Release a stable version: bump, check, commit, tag, push, then update the Homebrew tap.
# Never overwrites a tag or force-pushes either repository.
#
#   tools/release [--dry-run] VERSION [--tap PATH] [--remote NAME]
#   tools/release --tap-only VERSION [--tap PATH]    (the tag is out; update the tap only)
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
repo=matthewsinclair/cldr
tap=${CLDR_TAP:-"$root/../Brew/homebrew-cldr"}
remote=${CLDR_REMOTE:-upstream}
dry_run=false
tap_only=false
version=

die() { echo "release: $*" >&2; exit 1; }
say() { echo "release: $*"; }
run() {
  if $dry_run; then
    echo "  would run: $*"
  else
    "$@"
  fi
}
usage() { echo "Usage: tools/release [--dry-run | --tap-only] VERSION [--tap PATH] [--remote NAME]"; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=true ;;
    --tap-only) tap_only=true ;;
    --tap | --remote)
      option=$1
      shift
      [ "$#" -gt 0 ] || die "$option requires a value"
      case "$option" in --tap) tap=$1 ;; --remote) remote=$1 ;; esac
      ;;
    -h | --help) usage; exit 0 ;;
    -*) usage >&2; die "unknown option: $1" ;;
    *) [ -z "$version" ] || die "expected one version"; version=$1 ;;
  esac
  shift
done

[ -n "$version" ] || { usage >&2; exit 1; }
printf '%s' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || die "VERSION is X.Y.Z, without a v"
tag="v$version"
copyright="(C) hello@matthewsinclair.com"

clean() { [ -z "$(git -C "$1" status --porcelain)" ] || die "$1 has uncommitted changes"; }

[ -d "$tap/.git" ] || die "no tap checkout at $tap (set CLDR_TAP or --tap)"
clean "$tap"

if ! $tap_only; then
  cd "$root"
  [ "$(git branch --show-current)" = main ] || die "not on main"
  clean "$root"
  git fetch --quiet "$remote" main --tags
  [ "$(git rev-parse HEAD)" = "$(git rev-parse "$remote/main")" ] || die "main differs from $remote/main"
  if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then die "$tag exists"; fi

  current=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)
  say "$current -> $version"
  if [ "$current" != "$version" ]; then
    run sed -i.bak "s/^version = \"$current\"$/version = \"$version\"/" Cargo.toml
    run rm -f Cargo.toml.bak
  fi
  run cargo fmt --check
  run cargo clippy --all-targets -- -D warnings
  run cargo test --quiet
  run cargo build --release
  run sh tools/formula --check
  if [ "$current" != "$version" ]; then
    run git add Cargo.toml Cargo.lock
    run git commit --quiet -m "Release $tag" -m "$copyright"
  fi
  run git tag -a "$tag" -m "Cldr $tag"
  run git push --atomic "$remote" main "$tag"
fi

say "formula for $tag"
url="https://github.com/$repo/archive/refs/tags/$tag.tar.gz"
if $dry_run; then
  sha=$(printf '%064d' 0)
  echo "  would fetch $url for its SHA-256"
else
  sha=$(curl -fsSL "$url" | shasum -a 256 | cut -d ' ' -f 1)
fi
mkdir -p "$tap/Formula"
if $dry_run; then
  echo "  would render $tap/Formula/cldr.rb"
else
  sh "$root/tools/formula" render "$tag" "$sha" "$tap/Formula/cldr.rb"
fi
run git -C "$tap" add Formula/cldr.rb
run git -C "$tap" commit --quiet -m "cldr $tag" -m "$copyright"
run git -C "$tap" push --quiet origin HEAD
say "done: brew upgrade cldr (or brew install matthewsinclair/cldr/cldr)"
